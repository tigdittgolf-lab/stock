# =====================================================================
# Configuration backend - Mode OFFLINE
# =====================================================================
# À copier en backend/.env (ou généré automatiquement par le lanceur).
# Ce fichier documente les variables comprises par le backend Hono
# lorsqu'il tourne en local (sans Internet).
# =====================================================================

# --- Serveur ---
PORT=3005
NODE_ENV=production

# --- Base de données MySQL locale ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=2025_bu01
MYSQL_USER=root
MYSQL_PASSWORD=

# (Optionnel) Base d'authentification séparée
AUTH_MYSQL_DATABASE=stock_management_auth

# --- Sécurité / CORS ---
# En mode offline, on accepte toutes les origines locales et LAN.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# IMPORTANT : en mode offline, NE PAS définir SUPABASE_URL ni
# SUPABASE_SERVICE_ROLE_KEY. Le backend utilisera uniquement MySQL.
