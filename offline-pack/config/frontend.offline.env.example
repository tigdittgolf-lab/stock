# =====================================================================
# Configuration frontend - Mode OFFLINE
# =====================================================================
# À copier en .env.local (ou généré automatiquement par le lanceur).
# Ce fichier documente toutes les variables comprises par le frontend
# lorsqu'il tourne en mode local (sans Internet).
# =====================================================================

# --- Mode offline ---
# 'standalone' : 1 PC, tout en localhost
# 'server'     : ce PC héberge le serveur pour le LAN
# 'client'     : ce PC se connecte à un serveur existant
NEXT_PUBLIC_OFFLINE_MODE=standalone

# --- Backend ---
# URL du backend Hono local.
# En mode standalone/server : localhost
# En mode client : IP du serveur (ex: http://192.168.1.50)
NEXT_PUBLIC_API_URL=http://localhost:3005/api
NEXT_PUBLIC_BACKEND_PORT=3005

# --- Base de données ---
# En offline, toujours MySQL (le backend s'en occupe).
NEXT_PUBLIC_DB_TYPE=mysql

# --- Tenant (business unit) ---
NEXT_PUBLIC_TENANT=2025_bu01

# --- Serveur Next.js ---
PORT=3000
NODE_ENV=production

# IMPORTANT : en mode offline, NE PAS définir les variables Supabase.
# NEXT_PUBLIC_SUPABASE_URL et NEXT_PUBLIC_SUPABASE_ANON_KEY doivent être absentes
# pour éviter que l'application n'essaie de contacter le cloud.
